    const I = [1, 0, 0, 0, 1, 0, 0, 0, 1];
    const tailAx = (() => { const tp = rig.sprites.find((s) => s.name === "tail")!.pivot, dx = 798 - tp[0], dy = 394 - tp[1], L = Math.hypot(dx, dy); return [dx / L, dy / L, L]; })();
    const bend1 = (root: number[], ux: number, uy: number, L: number, a: number, a2: number) => {
