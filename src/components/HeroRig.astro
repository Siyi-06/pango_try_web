  }
  if (host && sp_cv && RAIN) {
    const ctx = sp_cv.getContext("2d")!;
    const touchDev = matchMedia("(pointer: coarse)").matches;
    const dpr = Math.min(touchDev ? 1.5 : 2, window.devicePixelRatio || 1), MAXP = touchDev ? 650 : 1600, PER = touchDev ? 4 : 7;
    const spr = document.createElement("canvas"); spr.width = spr.height = 48;
    const sc = spr.getContext("2d")!; const gr = sc.createRadialGradient(24, 24, 0, 24, 24, 24);
    gr.addColorStop(0, "rgba(255,250,232,1)"); gr.addColorStop(.12, "rgba(255,238,196,.95)");
    gr.addColorStop(.35, "rgba(236,196,122,.45)"); gr.addColorStop(1, "rgba(200,145,63,0)");
    sc.fillStyle = gr; sc.fillRect(0, 0, 48, 48);
    type P = { x: number; y: number; vx: number; vy: number; life: number; decay: number; r: number; tw: number; glint: boolean; g: number };
    const ps: P[] = []; let W = 0, H = 0, f = 0, rx = -9999, ry = -9999, lastRain = 0;
    const fit = () => { const r = host.getBoundingClientRect(); if (Math.abs(r.width - W) < 1 && Math.abs(r.height - H) < 1) return;
      W = r.width; H = r.height; sp_cv.width = Math.round(W * dpr); sp_cv.height = Math.round(H * dpr); };
    fit(); window.addEventListener("resize", fit);
    const spawn = (x: number, y: number, n: number, spread: number, fall = 1, glow = 1) => {
      for (let i = 0; i < n; i++) ps.push({ x: x + (Math.random() - .5) * spread, y: y + (Math.random() - .5) * spread * .35,
        vx: (Math.random() - .5) * .2, vy: (.1 + Math.random() * .35) * fall, life: 1, decay: .0022 + Math.random() * .0035,
        r: .8 + Math.random() * 2, tw: Math.random() * 6.28, glint: Math.random() < .2 * glow, g: glow });
      if (ps.length > MAXP) ps.splice(0, ps.length - MAXP);
    };
    let petX = 0;
    let burst = 0;
    rainAt = (cx, cy) => {
      const r = host.getBoundingClientRect(), x = cx - r.left, y = cy - r.top;
      rx = x; ry = y;
      const tt = performance.now();
      if (tt - lastRain > 22) { lastRain = tt; burst = 0; spawn(x, y - 30, PER, Math.min(320, W * .8), .9, 1.3); }
      else if (burst++ < 3) spawn(x, y - 30, PER, Math.min(320, W * .8), .9, 1.3);   // tap burst
    };
    rainOff = () => { rx = ry = -9999; };
    let lastR = performance.now(), amb = 0;
    const frame = () => {
      if (!visible) { rainRun = false; return; }
      const tn = performance.now(), R = Math.min(3, Math.max(.25, (tn - lastR) / 16.667)); lastR = tn;   // frame length in 60 fps frames
      f += R;
      amb += .27 * R; while (amb >= 1) { amb -= 1; spawn(Math.random() * W, Math.random() * H, 1, 0, .72, .7); }   // ambient: same rate as before
