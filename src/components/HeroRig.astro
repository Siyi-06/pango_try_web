        else if (sp.name === "arm") { M = rotAbout(life.arm.x * AMP, sp.pivot[0], sp.pivot[1]); kind = 4; }
        else if (sp.name === "tail") { bend1(sp.pivot, tailAx[0], tailAx[1], tailAx[2], life.tail.x * AMP, life.tailTip.x * AMP); kind = 5; }
        else if (sp.name === "shield") kind = 2;
