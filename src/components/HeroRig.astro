    };
    resume = () => { if (running || !visible) return; running = true; last = now(); requestAnimationFrame(frame); };
    running = true; requestAnimationFrame(frame);
  };
  start().catch((e) => { console.warn("rig", e); wrap.dataset.s = "fail " + e; });
  // phones can drop the graphics to save memory: show the still logo meanwhile, then rebuild the pangolin
  cv.addEventListener("webglcontextlost", (e) => { e.preventDefault(); gen++; running = false; wrap.classList.remove("on"); });
  cv.addEventListener("webglcontextrestored", () => { start().catch((e) => { console.warn("rig", e); }); });

  // ---------------------------------------------------------------- pointer + golden rain (same as the homepage)
  const RAIN = true;                                   // golden rain (settings identical to the homepage)
  // one "feel" for mouse and finger: (cx, cy) = screen point, (mx, my) = movement since the last event
  let rainAt = (_cx: number, _cy: number) => {}, rainOff = () => {};
  const feel = (cx: number, cy: number, mx: number, my: number) => {
    const c = cv.getBoundingClientRect();
    if (!(c.width > 4 && c.height > 4) || !Number.isFinite(cx) || !Number.isFinite(cy)) return;   // not laid out yet / bad event
    if (!Number.isFinite(mx)) mx = 0; if (!Number.isFinite(my)) my = 0;                          // e.g. a browser without movementX
    mx = Math.max(-80, Math.min(80, mx)); my = Math.max(-80, Math.min(80, my));
    mouse.x = (cx - c.left) / c.width; mouse.y = (cy - c.top) / c.height;
    mouse.on = mouse.x > -.15 && mouse.x < 1.15 && mouse.y > -.15 && mouse.y < 1.15 ? 1 : 0;
    if (Math.hypot(cx - (c.left + .652 * c.width), cy - (c.top + .27 * c.height)) < 70 * c.width / 760) life.blinkNow(now());
    mouse.vx += mx / c.width * 1024 * .35; mouse.vy += my / c.height * 757 * .35;
    const bx = (mouse.x - .45) / .32, by = (mouse.y - .6) / .34;
    if (bx * bx + by * by < 1) { const sp = Math.min(40, Math.hypot(mx, my) * 760 / c.width); happy = Math.min(1, happy + sp * .0034);
      petN += sp; if (petN > 280) { petN = 0; life.petted(now()); } }
    rainAt(cx, cy);
  };
  const leave = () => { mouse.on = 0; rainOff(); };
  let petN = 0, lastTouch = -1e9, tx = 0, ty = 0, liftT = 0;
  if (host && sp_cv) {
    host.addEventListener("mousemove", (e) => { if (performance.now() - lastTouch > 800) feel(e.clientX, e.clientY, e.movementX, e.movementY); });
    host.addEventListener("mouseleave", leave);
    // phone / tablet: a tap pets it (happy + rain burst), a swipe strokes it; scrolling still works (passive)
    host.addEventListener("touchstart", (e) => {
      const t = e.touches[0]; lastTouch = performance.now(); clearTimeout(liftT); tx = t.clientX; ty = t.clientY;
      feel(tx, ty, 0, 0);
      const c = cv.getBoundingClientRect(), bx = (mouse.x - .45) / .32, by = (mouse.y - .6) / .34;
      if (mouse.on && bx * bx + by * by < 1.2) { happy = Math.min(1, happy + .35); life.petted(now());
        pulses.push({ x: mouse.x * 1024, y: mouse.y * 757, t: rigT, s: 1.1 }); }
