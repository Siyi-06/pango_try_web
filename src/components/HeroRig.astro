    const draw1 = (s: { rect: number[]; at: number[] }, M: number[], kind: number) => {
      gl.uniform4f(u.rect, s.rect[0], s.rect[1], s.rect[2], s.rect[3]); gl.uniform2f(u.at, s.at[0], s.at[1]);
      gl.uniformMatrix3fv(u.M, false, M); gl.uniform1i(u.kind, kind); gl.uniform1f(u.pad, kind === 5 ? 16 : 0);
      gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
    };
    const fit = () => { const r = cv.getBoundingClientRect(), d = Math.min(2, devicePixelRatio || 1);
      const w = Math.round(r.width * d), h = Math.round(r.height * d); if (w === cv.width && h === cv.height) return;
      cv.width = w; cv.height = h; gl.viewport(0, 0, w, h); };
    wrap.classList.add("on"); fit(); addEventListener("resize", fit);
    const t0 = now(); let last = t0;
    const frame = () => {
      if (my !== gen) return;
      if (!visible) { running = false; return; }
      const tn = now(); F = Math.min(3, Math.max(.25, (tn - last) * 60)); last = tn;
      const t = tn - t0, g = gust(t); rigT = t;
      mouse.sx += (mouse.x - mouse.sx) * ap(.35); mouse.sy += (mouse.y - mouse.sy) * ap(.35); mouse.son += (mouse.on - mouse.son) * ap(.12);
      const vk = Math.pow(.9, F); mouse.vx *= vk; mouse.vy *= vk; happy = Math.max(0, happy - .0025 * F);
      const nb = Math.hypot((mouse.sx - .5) / .55, (mouse.sy - .5) / .6); mouse.near += ((mouse.son && nb < 1.2 ? 1 : 0) * mouse.son - mouse.near) * ap(.12);
