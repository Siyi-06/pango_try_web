      gl.uniform1f(u.t, t); gl.uniform1f(u.light, g); gl.uniform1f(u.smile, life.smile); gl.uniform1f(u.nose, life.nose);
      gl.uniform1f(u.blink, life.blink); gl.uniform1f(u.squint, Math.min(1, happy * 2.2)); gl.uniform1f(u.mon, mouse.near); gl.uniform2f(u.mpos, mouse.sx * W, mouse.sy * H); gl.uniform1f(u.claw, life.claw.x * AMP); gl.uniform1f(u.cometA, (t * .35) % 6.2832 - 3.1416);
