---
// Local test page for the layered pangolin. Not linked anywhere; the homepage is unchanged.
import Base from "../layouts/Base.astro";
import HeroRig from "../components/HeroRig.astro";
---
<Base darkHeader title="Hero lab — Pangolyn Systems" description="Local test page.">
  <section class="home-hero" data-sparks>
    <canvas class="sparks" aria-hidden="true"></canvas>
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">Post-quantum security · Singapore</span>
        <h1>Armour for the <em class="nowrap">post&#8209;quantum</em> era.</h1>
        <p class="lede">Layered pangolin (test). Parts move with the wind; shield and ring stay still, only their light changes.</p>
      </div>
      <div class="hero-art"><HeroRig /></div>
    </div>
  </section>
</Base>

<style>
  .home-hero { position: relative; overflow: hidden; background: #000; color: #e9e6dc; min-height: calc(100vh - 70px);
               display: flex; align-items: center; padding: clamp(32px, 5vw, 64px) 0; }
  .home-hero > .wrap { width: 100%; }
  .home-hero .wrap { position: relative; z-index: 1; }
  .sparks { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 2; }
  .home-hero .eyebrow { color: var(--gold); }
  .home-hero .lede { color: #b9b4a8; }
  .hero-grid { display: grid; grid-template-columns: 1fr 1.15fr; gap: clamp(24px, 5vw, 64px); align-items: center; }
  .hero-copy { display: grid; gap: 24px; }
  .hero-copy h1 { font-weight: 600; color: #fff; }
  .hero-copy h1 em { color: var(--gold); font-weight: 400; }
  @media (max-width: 860px) { .hero-grid { grid-template-columns: 1fr; } .hero-art { order: -1; width: 100%; max-width: 320px; margin: 0 auto; } }
</style>
