---
import { url } from "../lib/url";
import Base from "../layouts/Base.astro";
import Icon from "../components/Icons.astro";
import Cta from "../components/Cta.astro";
import HeroRig from "../components/HeroRig.astro";
---
<Base darkHeader title="Pangolyn Systems — Armour for the post-quantum era"
      description="Hardware-rooted, post-quantum protection for the data you store and the devices it moves through.">

  <!-- HERO (light, white-background logo) -->
  <section class="home-hero" data-sparks>
    <canvas class="sparks" aria-hidden="true"></canvas>
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">Post-quantum security · Singapore</span>
        <h1>Armour for the <em class="nowrap">post&#8209;quantum</em> era.</h1>
        <p class="lede">Pangolyn builds hardware-rooted, post-quantum protection for the data you store and the devices it moves through — deployed inside your own environment, with keys only you control.</p>
        <div class="cta-row">
          <a href={url("/contact")} class="btn btn--primary">Request a briefing <span class="arrow">→</span></a>
          <a href="#products" class="btn btn--ghost">Explore products</a>
        </div>
      </div>
      <div class="hero-art"><HeroRig /></div>
    </div>
  </section>

  <!-- THE PROBLEM, SHORT -->
  <section class="section">
    <div class="wrap">
      <div class="head reveal">
        <span class="eyebrow">The problem</span>
        <h2>Quantum won't break your <span class="hl-safe">safe</span>. It will break your <span class="hl-risk">key box</span>.</h2>
      </div>
      <div class="cards3 reveal">
        <article class="card-x risk">
          <span class="n">01</span>
          <h3>Your data outlives its keys</h3>
          <p>Audit records are kept 7 years. Designs, contracts and archives far longer — <span class="hl-risk">well past 2035</span>, when NIST retires RSA and ECC.</p>
        </article>
        <article class="card-x risk">
          <span class="n">02</span>
          <h3>The key box is the weak link</h3>
          <p><span class="hl-safe">AES-256 stays strong.</span> <span class="hl-risk">The RSA/ECC lock on its key does not</span> — open that, and the data opens too.</p>
        </article>
        <article class="card-x risk">
          <span class="n">03</span>
          <h3>Stolen today, opened tomorrow</h3>
          <p>A backup copied now <span class="hl-risk">only needs to wait</span>. Every nightly copy carries the same weak key box.</p>
        </article>
      </div>
      <p class="more reveal"><a class="link" href={url("/why-quantum")}>Why quantum matters — the full picture →</a></p>
    </div>
  </section>

  <!-- PRODUCTS -->
  <section class="section sand" id="products">
    <div class="wrap">
      <div class="head reveal">
        <span class="eyebrow">Products</span>
        <h2>Protection at <span class="w-rest">rest</span>, and at the <span class="w-root">root</span> of every device.</h2>
      </div>
      <div class="two reveal">
        <a class="product rest" href={url("/cipherguard")}>
          <span class="chip"><span class="dot pulse"></span>In development</span>
          <span class="pfor pfor-rest">For data at rest</span>
          <h3 class="pname">CipherGuard</h3>
          <p class="psub">Post-quantum protection for stored data. Re-protects the keys behind your databases, backups and archives — no mass re-encryption.</p>
          <div class="kswap" aria-label="Your data keeps its safe and its RSA key; Pangolyn adds a quantum-safe key box that locks the RSA key inside">
            <figure class="kf k-data"><Icon kind="safe" size={130} /><figcaption>Your data</figcaption></figure>
            <div class="kpair">
              <figure class="kf k-old">
                <span class="kv kv-weak"><Icon kind="keybox-weak" size={100} /></span>
                <span class="kv kv-safe"><Icon kind="key-safe" size={100} /></span>
                <figcaption><span class="kc kc-weak bad">RSA key box</span><span class="kc kc-safe">Our key box · quantum-safe</span></figcaption>
              </figure>
              <div class="kbox" aria-hidden="true">
                <svg class="kbadge" viewBox="0 0 24 32" width="26" height="34"><path d="M0 0h24v14c0 9-6 15-12 18C6 29 0 23 0 14z" fill="#1f1f1f" /><path d="M12 6l2.5 6.5 6.5 2.5-6.5 2.5-2.5 6.5-2.5-6.5-6.5-2.5 6.5-2.5z" fill="#c8913f" /></svg>
              </div>
            </div>
          </div>
          <span class="link">Explore CipherGuard →</span>
        </a>
        <a class="product dark" href={url("/cipherlink")}>
          <span class="chip chip--night"><span class="dot pulse"></span>In development</span>
          <span class="pfor pfor-root">For the root of every device</span>
          <h3 class="pname">CipherLink</h3>
          <p class="psub">Post-quantum trust for every device link. One firmware that lets PCIe and USB-C devices prove they are genuine with quantum-safe checks.</p>
          <div class="linkviz" aria-hidden="true">
            <span class="node">Device</span><span class="wire"><i></i></span><span class="node core">CipherLink</span><span class="wire w2"><i></i></span><span class="node">System</span>
          </div>
          <span class="link link--gold">Explore CipherLink →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- DARK BAND (black logo) -->
  <section class="section band-dark">
    <div class="wrap">
      <div class="dark-intro reveal">
        <div>
          <span class="eyebrow">Trust by design</span>
          <h2 class="t2">Your keys. Your hardware. Never ours.</h2>
        </div>
      </div>
      <div class="two reveal">
        <div class="tile"><div class="tile-head gold">Delivered your way</div>
          <ul class="ticks"><li>Software on your servers</li><li>A Pangolyn hardware appliance</li><li>Your cloud, or fully offline</li></ul></div>
        <div class="tile"><div class="tile-head">No single point of trust</div>
          <ul class="ticks"><li>No copies of your keys — ever</li><li>No data sent to us</li><li>Verified hardware and software</li><li>Crypto-agility</li></ul></div>
      </div>
    </div>
  </section>

  <!-- WHY NOW -->
  <section class="section">
    <div class="wrap">
      <div class="head reveal">
        <span class="eyebrow">Why now</span>
        <h2>The deadline is already set.</h2>
      </div>
      <ol class="timeline deadline reveal">
        <li class="gold"><span class="when big-y">2024</span><span class="dot">1</span><h3>First quantum-safe standards</h3><p>NIST publishes FIPS 203, 204 and 205.</p></li>
        <li class="gold"><span class="when big-y">2026</span><span class="dot">2</span><h3>The plan is final</h3><p>NIST fixes the date to retire RSA and ECC.</p></li>
        <li class="red"><span class="when big-y">2030</span><span class="dot">3</span><h3>RSA / ECC deprecated</h3><p>Allowed only with a documented risk decision.</p></li>
        <li class="red"><span class="when big-y">2035</span><span class="dot">4</span><h3>RSA / ECC disallowed</h3><p>No longer acceptable under NIST standards.</p></li>
      </ol>
      <p class="sources">Sources: <a href="https://doi.org/10.6028/NIST.FIPS.203" target="_blank" rel="noopener">NIST FIPS 203</a> · <a href="https://doi.org/10.6028/NIST.IR.8547" target="_blank" rel="noopener">NIST IR 8547</a></p>
    </div>
  </section>

  <Cta />
</Base>

<style>
  .home-hero { position: relative; overflow: hidden; background: #000; color: #e9e6dc; min-height: calc(100vh - 70px); min-height: calc(100svh - 70px);
               display: flex; align-items: center; padding: clamp(32px, 5vw, 64px) 0; }
  .home-hero > .wrap { width: 100%; }
  .home-hero .wrap { position: relative; z-index: 1; }
  .sparks { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 2; }
  .home-hero .eyebrow { color: var(--gold); }
  .home-hero .lede { color: #b9b4a8; }
  .home-hero .btn--primary { background: var(--gold); color: #000; } .home-hero .btn--primary:hover { background: var(--gold-soft); }
  .home-hero .btn--ghost { border-color: #555; color: #fff; } .home-hero .btn--ghost:hover { background: #fff; color: #000; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: clamp(24px, 5vw, 64px); align-items: center; }
  .hero-copy { display: grid; gap: 24px; }
  .hero-copy h1 { font-weight: 600; color: #fff; }
  .hero-copy h1 em { color: var(--gold); font-weight: 400; }
  .hero-copy .lede { max-width: 560px; }
  @media (max-width: 860px) { .hero-grid { grid-template-columns: minmax(0, 1fr); } .hero-art { order: -1; width: 100%; max-width: 320px; margin: 0 auto; } }
  .t2 { font-weight: 600; margin: 10px 0 16px; font-size: clamp(1.7rem, 3.2vw, 2.4rem); }
  .product { display: flex; flex-direction: column; gap: 16px; text-decoration: none; color: inherit; background: #fff; border: 1px solid var(--line);
             border-top: 4px solid var(--gold); padding: clamp(24px, 3vw, 38px); transition: transform .25s, box-shadow .25s; }
  .product:hover { transform: translateY(-4px); box-shadow: 0 20px 40px -26px rgba(20,20,19,.4); }
  /* solutions: "rest" and "root" share the brand gold */
  .w-rest, .w-root { font-style: italic; font-weight: 500; }
  .w-rest, .w-root { color: var(--bronze); }
  .pfor { font: 600 .74rem/1 var(--sans); letter-spacing: .1em; text-transform: uppercase; margin-bottom: -8px; }
  .pfor-rest { color: var(--bronze); } .pfor-root { color: var(--gold); }
  .product.dark { background: #000; color: #e9e6dc; border-color: #000; border-top-color: var(--gold); }
  .pname { font-size: clamp(1.9rem, 3vw, 2.5rem); font-weight: 600; } .product.dark .pname { color: #fff; }
  .psub { color: var(--ink-soft); } .product.dark .psub { color: #b9b4a8; }
  .chip--night { background: rgba(200,145,63,.16); color: var(--gold-soft); }
  .link--gold { color: var(--gold-soft); border-color: rgba(233,201,143,.35); }
  .product .link { width: fit-content; margin-top: auto; }
  .product .kswap, .product .linkviz { flex: 1; }
  .dot.pulse { animation: pulse 1.8s ease-in-out infinite; }
  @keyframes pulse { 0%,100% { box-shadow: 0 0 0 0 rgba(200,145,63,.6); } 50% { box-shadow: 0 0 0 5px rgba(200,145,63,0); } }
  /* CipherGuard: the RSA key stays; our quantum-safe key box is added on top. Icons share one centre line with "Your data". */
  .kswap { display: flex; align-items: center; justify-content: center; gap: 22px; padding: 22px 0 56px; }
  .kf { margin: 0; position: relative; height: 130px; display: flex; align-items: center; justify-content: center; line-height: 0; }
  .kf figcaption { position: absolute; top: calc(100% + 8px); left: 50%; transform: translateX(-50%); width: 130px; text-align: center;
                   font: 600 .72rem/1.25 var(--sans); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
  .kpair { position: relative; padding: 0 8px; }
  /* our key box closes around the RSA key: the key stays, it is now locked inside a quantum-safe box */
  .kbox { position: absolute; inset: 4px -10px; border: 3px solid var(--gold); border-radius: 12px;
          background: rgba(200,145,63,.07); box-shadow: 0 0 24px rgba(200,145,63,.28); opacity: 0;
          animation: kAdd 8s cubic-bezier(.3,.7,.3,1) infinite; }
  .kbadge { position: absolute; top: -15px; right: -13px; }
  .kcap { position: absolute; top: calc(100% + 34px); left: 50%; transform: translateX(-50%); width: 170px; text-align: center;
          font: 600 .72rem/1.25 var(--sans); letter-spacing: .08em; text-transform: uppercase; color: var(--gold-deep, #8f6226); }
  /* once our box closes around it, the red warning goes and the key turns safe */
  .kv { display: block; line-height: 0; }
  .kv-safe { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); opacity: 0; animation: kSafe 8s ease-in-out infinite; }
  .kv-weak { animation: kWeak 8s ease-in-out infinite; transform: translate(4px, -6px); }   /* red key sits exactly where the gold key will be */
  .kv-weak :global(svg) { animation: kWarn 8s ease-in-out infinite; }
  .k-old figcaption { display: grid; width: 150px; align-items: start; } .kc { grid-area: 1 / 1; }
  .kc-weak { animation: kWeak 8s ease-in-out infinite; }
  .kc-safe { color: var(--bronze); opacity: 0; animation: kSafe 8s ease-in-out infinite; }
  @keyframes kWeak { 0%, 47% { opacity: 1; } 60%, 90% { opacity: 0; } 97%, 100% { opacity: 1; } }
  @keyframes kSafe { 0%, 47% { opacity: 0; } 60%, 90% { opacity: 1; } 97%, 100% { opacity: 0; } }
  @keyframes kWarn { 0%, 6%, 18%, 30%, 100% { filter: none; } 12%, 24% { filter: drop-shadow(0 0 8px rgba(181,72,46,.75)); } }
  @keyframes kAdd  { 0%, 32% { opacity: 0; transform: translateX(70px) scale(1.08); } 48%, 90% { opacity: 1; transform: none; }
                     98%, 100% { opacity: 0; transform: none; } }
  @media (max-width: 560px) {
    .kswap { gap: 10px; } .kpair { padding: 0 4px; } .kcap { width: 120px; font-size: .62rem; top: calc(100% + 28px); }
    .kf { height: 92px; } .k-data :global(svg) { width: 92px; height: 92px; } .k-old :global(svg) { width: 72px; height: 72px; } .kv-weak { transform: translate(3px, -4px); }
    .kf figcaption { width: 96px; font-size: .62rem; }
  }
  .linkviz { display: flex; align-items: center; margin: 6px 0; }
  .node { border: 1px solid #6a655c; background: #2c2a27; color: #f3efe7; font-size: .95rem; font-weight: 600; padding: 16px 18px; white-space: nowrap; }
  .node.core { background: var(--gold); color: #000; border-color: var(--gold); }
  .wire { flex: 1; height: 5px; border-radius: 3px; background: #4a4640; position: relative; overflow: hidden; box-shadow: 0 0 6px rgba(200,145,63,.25); min-width: 30px; }
  .wire i { position: absolute; top: 0; left: -30%; width: 34%; height: 100%; background: linear-gradient(90deg, transparent, #f3c56a 35%, #fff3d0 50%, #f3c56a 65%, transparent); box-shadow: 0 0 10px rgba(255,210,120,.85); animation: travel 2.2s linear infinite; }
  .wire.w2 i { animation-delay: 1.1s; }
  @keyframes travel { to { left: 100%; } }
  @media (max-width: 420px) { .node { padding: 12px 9px; font-size: .84rem; } .wire { min-width: 16px; } }
  .mini-steps { margin: 0 0 26px; padding-left: 1.3em; display: grid; gap: 8px; color: var(--ink-soft); }
  .mini-steps b { color: var(--ink); }
  .dark-intro { display: flex; align-items: center; gap: 28px; margin-bottom: 32px; }
  .dark-intro img { width: 150px; }
  @media (max-width: 600px) { .dark-intro { flex-direction: column; align-items: flex-start; } }
</style>
